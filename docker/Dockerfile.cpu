FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/heteropar-tutorial

COPY . .

RUN cmake -S . -B build -DHETEROPAR_ENABLE_TESTS=ON \
    && cmake --build build --parallel \
    && ctest --test-dir build -L 'cpu|python' --output-on-failure

CMD ["ctest", "--test-dir", "build", "-L", "cpu|python", "--output-on-failure"]
