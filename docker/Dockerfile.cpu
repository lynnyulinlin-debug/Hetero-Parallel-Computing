FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/heteropar-tutorial

COPY . .

RUN python3 -m pip install --no-cache-dir -r examples/ch11_npu_deploy/requirements.txt

CMD ["/bin/bash"]
